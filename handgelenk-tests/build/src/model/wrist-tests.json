{
  "_meta": {
    "version": 1,
    "status": "draft from claude.ai chat 2026-10-01, to be refined in Claude Code",
    "conventions": {
      "rot": "forearm rotation in deg: negative = pronation (palm down), positive = supination (palm up), 0 = thumb up",
      "ext": "wrist in deg: positive = extension, negative = flexion",
      "dev": "wrist in deg: positive = ulnar (pinky side), negative = radial (thumb side)",
      "elbow": "elbow flexion in deg (0 = straight, 90 = right angle)",
      "fingers": "finger curl 0 = open, 1 = full fist",
      "grip": "grip force 0..1",
      "axial": "axial load through the wrist 0..1 (body weight, examiner push)",
      "force.dir": "anatomical direction in the local frame of the bone at the landmark: palmar | dorsal | radial | ulnar | proximal | distal | rotate_pronation | rotate_supination",
      "force.by": "examiner | self | body | table",
      "landmarks": "LM_<id> empties in the glb, see HANDOVER.md 6.3",
      "hyper": "optional extra kinematic offsets shown when the hypermobility toggle is on",
      "view": "camera preset for the test: free | dorsal | thumb | palm | ulnar | end",
      "risk": "1 = safe to try yourself, 2 = careful: load or a partner involved, 3 = examiner only",
      "present": "default presentation: skin | xray | bones",
      "body": "per step: posture scene for the mannequin inset: seated_table | seated_elbow_vertical | seated_under_table | chair_press | chair_press_up | standing",
      "holds": "per step: where a second person fixes the limb: forearm | wrist | hand (drawn as a ring)"
    },
    "globalRules": [
      "Always compare with the other side; in a hypermobile wrist only asymmetry or reproducing the usual pain counts.",
      "Gentle, a few repetitions, stop at sharp pain.",
      "A positive test is a hint, not a diagnosis; tests overlap and are often wrong.",
      "Film clunks and snaps for the doctor; they often do not happen on command."
    ]
  },
  "tests": [
    {
      "id": "ulnar_fovea_sign",
      "name": "Ulnar fovea sign",
      "group": "TFCC / ulnar side",
      "targets": [
        "tfcc",
        "ulnocarpal"
      ],
      "needsPartner": false,
      "homeOk": true,
      "steps": [
        {
          "dur": 1.5,
          "pose": {
            "rot": 0,
            "ext": 0,
            "dev": 0,
            "elbow": 90
          },
          "text": "Rest the forearm on a table, thumb up, wrist relaxed.",
          "body": "seated_table"
        },
        {
          "dur": 2.0,
          "pose": {
            "rot": 0,
            "ext": 0,
            "dev": 0,
            "elbow": 90
          },
          "contacts": [
            "ulnar_fovea"
          ],
          "forces": [
            {
              "at": "ulnar_fovea",
              "dir": "radial",
              "mag": 0.5,
              "by": "examiner"
            }
          ],
          "text": "Press a thumb into the soft spot between the ulnar styloid and the FCU tendon, palm side of the bony bump.",
          "body": "seated_table"
        }
      ],
      "positive": "Clear tenderness that reproduces your pain, more than on the other side.",
      "painZones": [
        "ulnar_fovea"
      ],
      "meaning": "Points to a foveal TFCC tear or an ulnotriquetral ligament injury.",
      "home": "Same, with your own thumb.",
      "source": "Tay, Tomita, Berger 2007 (high reported sensitivity)",
      "view": "palm",
      "risk": {
        "level": 1,
        "note": "Pressing with a thumb is harmless. Compare both sides."
      },
      "present": "bones"
    },
    {
      "id": "press_test",
      "name": "Press test",
