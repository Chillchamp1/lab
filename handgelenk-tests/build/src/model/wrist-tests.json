          "forces": [
            {
              "at": "pisiform",
              "dir": "dorsal",
              "mag": 0.9,
              "by": "body"
            }
          ],
          "text": "Push yourself up so your body weight goes through the extended wrists.",
          "body": "chair_press_up"
        }
      ],
      "positive": "Pain on the pinky side of the wrist.",
      "painZones": [
        "ulnar_fovea",
        "ulnar_head_dorsal"
