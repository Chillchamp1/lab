      "source": "Lester et al. 1995",
      "view": "ulnar",
      "risk": {
        "level": 2,
        "note": "Your body weight goes through the wrist. Stop at the first sharp pain; skip it while the wrist is acutely painful."
      },
      "present": "bones"
