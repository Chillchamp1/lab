   "begrenzt_db": 0.0,
   "sekunden": 564.6,
   "probe_abtastwerte": 1323000
  },
  {
   "name": "wellen",
   "titel": "Wellenkämme ringsum",
   "text": "Einzelne Wellenkämme in 7 bis 32 m Entfernung, jeder an einer anderen Stelle; sie treiben mit dem Wind. Brechen sie mit viel Kraft, grollt es tief.",
   "typ": "ereignisse",
   "ziel_lufs": -27,
   "pegel_art": "spitzen",
   "spitze_db": -9.0,
   "begrenzt_db": 0.1,
   "sekunden": 99.5,
   "probe_abtastwerte": 1323000
  },
  {
   "name": "rumpf",
   "titel": "Wasser am Holz",
   "text": "Schwapps und Klatscher gegen die Planken – auf der Seite, die beim Rollen gerade eintaucht. Harte Schläge bringen den Rumpf zum Schwingen: tiefe Eigenschwingungen des Holzes, die man im liegenden Körper spüren würde.",
   "typ": "rumpf",
   "ziel_lufs": -28,
   "pegel_art": "spitzen",
   "spitze_db": -9.0,
   "begrenzt_db": 0.4,
