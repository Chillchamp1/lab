  },
  {
   "name": "knarzen",
   "titel": "Knarzendes Holz",
   "text": "Dollen, Duchten und Spanten arbeiten, wenn das Boot sich neigt. Diese Klänge bleiben fest am Boot.",
   "typ": "knarzen",
   "ziel_lufs": -32,
